{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "repository": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "git": {
          "type": "object",
          "properties": {
            "initialized": {
              "type": "boolean"
            },
            "head_sha": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dirty": {
              "type": "boolean"
            },
            "changed_files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "initialized",
            "head_sha",
            "branch",
            "dirty",
            "changed_files"
          ]
        }
      },
      "required": [
        "root",
        "name",
        "git"
      ]
    },
    "setup": {
      "type": "object",
      "properties": {
        "policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_mode": {
          "type": "string",
          "enum": [
            "none",
            "local",
            "attested",
            "custom"
          ]
        },
        "contract": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "report": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "github_workflow": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "policy",
        "policy_mode",
        "contract",
        "report",
        "github_workflow"
      ]
    },
    "evidence": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "checks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "invariants": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "verifiers": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "surfaces": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "checks",
            "invariants",
            "verifiers",
            "surfaces"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "latest_run": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "trusted",
                "not_trusted",
                "insufficient_evidence"
              ]
            },
            "assurance": {
              "type": "string",
              "enum": [
                "trial",
                "local",
                "attested"
              ]
            },
            "created_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            "run_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "verdict",
            "assurance",
            "created_at",
            "run_id"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "command",
        "reason"
      ]
    }
  },
  "required": [
    "version",
    "repository",
    "setup",
    "evidence",
    "latest_run",
    "problems",
    "next"
  ],
  "$id": "urn:executable-trust:v1:status",
  "title": "Executable Trust repository status"
}
