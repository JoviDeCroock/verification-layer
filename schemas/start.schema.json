                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64
                },
                "signature": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "algorithm",
                "signer_id",
                "signed_at",
                "report_sha256",
                "signature"
              ]
