{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "expected_behaviors": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_mapping": {
            "type": "string",
            "enum": [
              "explicit",
              "inferred"
            ]
          }
        },
        "required": [
          "id",
          "description",
          "evidence"
        ]
      }
    },
    "affected_surfaces": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_evidence": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qa_missions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk": {
            "type": "string"
          },
          "viewport": {
            "default": "desktop",
            "type": "string",
            "enum": [
              "desktop",
              "mobile"
            ]
          },
          "generation": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "deterministic",
                  "model"
                ]
              },
              "generator": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "input_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "prompt_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "method",
              "generator",
              "version",
              "input_sha256"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "objective",
          "derived_from"
        ]
      }
    },
    "excluded": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "item",
          "reason"
        ]
      }
    },
    "approval": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved"
          ]
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "content_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "method": {
          "type": "string",
          "enum": [
            "local",
            "ed25519"
          ]
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status"
      ]
    }
  },
  "required": [
    "id",
    "intent",
    "expected_behaviors",
    "approval"
  ],
  "$id": "urn:executable-trust:v1:change-contract",
  "title": "Executable Trust change contract"
}
