{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "required_level": {
      "type": "string",
      "enum": [
        "trial",
        "local",
        "attested"
      ]
    },
    "readiness": {
      "type": "object",
      "properties": {
        "trial": {
          "type": "boolean"
        },
        "local": {
          "type": "boolean"
        },
        "attested": {
          "type": "boolean"
        }
      },
      "required": [
        "trial",
        "local",
        "attested"
      ]
    },
    "ready": {
      "type": "boolean"
    },
    "counts": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "invariants": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "verifiers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "surfaces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "active_approvers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "active_reporters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "checks",
        "invariants",
        "verifiers",
        "surfaces",
        "active_approvers",
        "active_reporters"
      ]
    },
    "verifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "version",
    "repository",
    "required_level",
    "readiness",
    "ready",
    "counts",
    "verifiers",
    "warnings",
    "problems"
  ],
  "$id": "urn:executable-trust:v1:doctor",
  "title": "Executable Trust doctor result"
}
