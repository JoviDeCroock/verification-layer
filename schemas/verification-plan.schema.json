{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "contract_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_verifiers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qa_required": {
      "type": "boolean"
    },
    "selection_reasons": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "version",
    "contract_id",
    "created_at",
    "changed_files",
    "affected_surfaces",
    "selected_checks",
    "selected_invariants",
    "qa_required",
    "selection_reasons"
  ],
  "$id": "urn:executable-trust:v1:verification-plan",
  "title": "Executable Trust verification plan"
}
